{
  "manifest_version": 3,
  "name": "1688toCSV",
  "version": "2.1.0",
  "description": "Keep a local 1688 order spreadsheet, reconcile changes, and copy products and images to Excel.",
  "permissions": ["alarms", "clipboardWrite", "unlimitedStorage", "tabs"],
  "host_permissions": ["https://cbu01.alicdn.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open order spreadsheet"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trade.1688.com/order/new_step_order_detail.htm*",
        "https://air.1688.com/app/ctf-page/trade-order-detail/index.html*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://air.1688.com/app/ctf-page/trade-order-list/buyer-order-list.html*",
        "https://work.1688.com/*"
      ],
      "all_frames": true,
      "js": ["list-content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
