{
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@zxing/library": "0.23.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "prettier": "3.8.1"
  },
  "version": "2.2.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "A Chrome extension to effortlessly export 1688.com order details into a clean CSV format.",
  "name": "1688tocsv",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --development",
    "build:prod": "npm run build",
    "check": "node scripts/check.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:excel": "powershell.exe -NoProfile -STA -File scripts/test-excel.ps1",
    "verify": "npm run check && npm run check:docs && npm test && npm run build && npm run test:browser",
    "preview": "node scripts/preview.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jsbarcode": "3.12.3"
  }
}
